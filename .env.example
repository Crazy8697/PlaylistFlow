# Copy to .env next to the program and fill in. Never commit the real .env.

# Spotify app (developer.spotify.com/dashboard).
# The secret is unused — auth is PKCE — but the client ID is required.
# Your own account must be listed under the app's User Management, or
# playlist reads return 403.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# BPM and musical key. Free tier, 1000 lookups/month. freqblog.com
FREQBLOG_API_KEY=

# Fallback BPM source. A visible backlink to getsongbpm.com is required by
# their terms — the About dialog carries it. getsongbpm.com/api
GETSONGBPM_API_KEY=

# Last-resort web search for tracks nothing else has.
# brave.com/search/api
BRAVE_API_KEY=
